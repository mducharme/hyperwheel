# Copy to .env and fill in. .env is git-ignored.
# Used by `npm run music` to generate tracks (never bundled into the site).
ELEVENLABS_API_KEY=

# Optional: preset wheels bundled into the site at build time (they can't be deleted).
# A folder URL (S3 bucket, CDN, …) that serves index.json — ["a.hyperwheel", …] or
# { "wheels": [ … ] } — next to the .hyperwheel files. Only read while building.
# Unset: ./presets/*.hyperwheel is used if that folder exists.
PRESET_WHEELS_URL=
